{
  "name": "@oxpulse/voice-core",
  "version": "0.3.0",
  "description": "OxPulse voice-core — shared framework-agnostic voice primitives (recorder, waveform, player).",
  "license": "AGPL-3.0-or-later",
  "author": "Anatoly Koptev",
  "homepage": "https://github.com/anatolykoptev/oxpulse-chat-sdk/tree/main/packages/voice-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/oxpulse-chat-sdk.git",
    "directory": "packages/voice-core"
  },
  "bugs": {
    "url": "https://github.com/anatolykoptev/oxpulse-chat-sdk/issues"
  },
  "keywords": [
    "oxpulse",
    "chat",
    "voice",
    "recorder",
    "waveform",
    "audio"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "tsc --outDir dist",
    "build": "tsc --outDir dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "stryker": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
