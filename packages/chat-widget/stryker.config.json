{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for @oxpulse/chat-widget — scoped to security-critical files (postmessage, iframe, bootstrap). element.ts (69KB UI renderer) excluded: 7206 mutants → ~80 min, and UI rendering is covered by E2E not unit-level mutation. Non-blocking baseline.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "vitest": {
    "configFile": "vitest.stryker.config.mjs"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "mutate": [
    "src/postmessage.ts",
    "src/iframe.ts",
    "src/bootstrap.ts"
  ],
  "reporters": ["json", "html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "timeoutMS": 60000,
  "concurrency": 1,
  "tempDirName": ".stryker-tmp"
}
