{
  "name": "oxpulse-chat-sdk-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test:contract": "vitest run --config e2e/vitest.config.ts",
    "release": "node scripts/release-npm-packages.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
